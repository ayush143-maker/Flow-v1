{
  "name": "flow",
  "version": "1.0.0",
  "private": true,
  "description": "Flow — your money, in flow. Local-first personal finance for Android.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
